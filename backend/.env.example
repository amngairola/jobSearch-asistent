# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Groq API Configuration  (REQUIRED)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Tavily API for Web Search  (REQUIRED for job discovery)
TAVILY_API_KEY=your_tavily_api_key_here

# Storage directory — set to an absolute path for production (Render persistent disk)
# Render example: /data
# Local example: leave blank to use ./data relative to backend folder
STORAGE_DIR=

# Playwright automation flag
# Set to "true" to allow the agent to auto-submit applications via Playwright
AGENT_ALLOW_AUTOMATION=false
