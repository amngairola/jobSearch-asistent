{
  "buildCommand": "cd frontend-new && npm install && npm run build",
  "outputDirectory": "frontend-new/dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://YOUR_RENDER_BACKEND_URL/api/$1" }
  ],
  "env": {
    "VITE_BACKEND_URL": "https://YOUR_RENDER_BACKEND_URL"
  }
}
